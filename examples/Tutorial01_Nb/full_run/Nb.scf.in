&CONTROL
  calculation='scf'
  restart_mode='from_scratch'
  prefix='Nb'
  pseudo_dir='./pseudos'
  outdir='./outdir'
/
&SYSTEM
  ibrav=0,
  nat=1,
  ntyp=1,
  nspin=1
    ecutwfc = 100
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.025
  la2F = .true.
/

&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.2
  diagonalization = 'cg'
/
ATOMIC_SPECIES
 Nb  92.90638 Nb.upf

CELL_PARAMETERS (angstrom)
   1.655326825   1.655326825   1.655326825
  -1.655326825   1.655326825   1.655326825
  -1.655326825  -1.655326825   1.655326825

ATOMIC_POSITIONS {crystal}
Nb            0.0000000000        0.0000000000        0.0000000000

K_POINTS automatic 
4 4 4 0 0 0
