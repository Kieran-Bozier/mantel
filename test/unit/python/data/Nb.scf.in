&CONTROL
  calculation='scf'
  restart_mode='from_scratch'
  prefix='Nb'
  pseudo_dir='${PSEUDO_DIR}'
  outdir='${SCRATCH_DIR}/Nb'
  verbosity='high'
/

&SYSTEM
  nbnd=20
  ibrav=0,
  nat=1,
  ntyp=1,
  nspin=1
  ecutwfc = 100,
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.025
/

&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
 Nb  92.90638 Nb.upf

CELL_PARAMETERS (angstrom)
   1.655821841   1.655821841   1.655821841
  -1.655821841   1.655821841   1.655821841
  -1.655821841  -1.655821841   1.655821841

K_POINTS automatic
  6  6  6  0  0  0

ATOMIC_POSITIONS {crystal}
Nb            0.0000000000        0.0000000000        0.0000000000

